# Supabase: Project Settings > Database > Connection string
# Pooler (Transaction mode, porta 6543) para a aplicação:
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Conexão direta (porta 5432) para migrations:
DIRECT_URL="postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres"

PORT=3333
NODE_ENV=development
# Origem do front (separe várias por vírgula)
CORS_ORIGIN="http://localhost:5173"
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Usados apenas pelo seed para criar a conta da administradora
ADMIN_NAME="Nathalia Rodrigues"
ADMIN_EMAIL="admin@nrstudio.com.br"
ADMIN_PASSWORD="troque-esta-senha"
